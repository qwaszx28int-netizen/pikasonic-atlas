{
  "name": "pikasonic-atlas",
  "private": true,
  "version": "1.0.0",
  "description": "An independent, non-commercial PIKASONIC discography and listening guide.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "start": "node server/index.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "sync:independent": "node scripts/sync-independent.mjs",
    "sync:netease": "node scripts/sync-netease.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
