{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pikasonic-atlas",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pikasonic-atlas-votes",
      "database_id": "05f8088b-3a7a-48ca-92c5-4742fe3f5378",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "READ_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 40, "period": 60 },
    },
  ],
}
