# Optional: override this when deploying a fork of the repository.
# The website uses it for the source-code and rights-request links.
VITE_REPOSITORY_URL=https://github.com/qwaszx28int-netizen/pikasonic-atlas

# Optional: on a static preview, show a link to your own full voting website.
# Leave empty for the full website itself.
VITE_FULL_SITE_URL=

# Production server environment (set through your host, not VITE_ variables):
# NODE_ENV=production
# PORT=3001
# SITE_ORIGIN=https://your-site.example
# DATABASE_PATH=/app/data/votes.sqlite

# Netlify Function and Cloudflare Worker only: set the same random server secret
# in each platform's environment settings. Never prefix secrets with VITE_.
# VOTING_PROXY_SECRET=
